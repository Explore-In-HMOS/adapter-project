<div class="container" onswipe="goHome">
    <text class="title" style="width: 240px;">
        {{ result }}
    </text>

    <input type="button" style="width: 240px; margin: 12px 0px; background-color: slateblue; padding: 4px 12px; border-radius: 8px;" @click="sha256">
        Sha256
    </input>

    <input type="button" style="width: 240px; margin: 12px 0px; background-color: slateblue; padding: 4px 12px; border-radius: 8px;" @click="createRandom">
        Random
    </input>
</div>
