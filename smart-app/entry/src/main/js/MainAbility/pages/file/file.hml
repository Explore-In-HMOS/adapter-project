<div class="container" onswipe="goHome">
    <text class="title" style="width: 240px;">
        {{ result }}
    </text>

    <input type="button" style="width: 240px; margin: 12px 0px; background-color: slateblue; padding: 4px 12px; border-radius: 8px;" @click="createDirectory">
        Create Directory
    </input>

    <input type="button" style="width: 240px; margin: 12px 0px; background-color: slateblue; padding: 4px 12px; border-radius: 8px;" @click="writeText">
        Write Text
    </input>

    <input type="button" style="width: 240px; margin: 12px 0px; background-color: slateblue; padding: 4px 12px; border-radius: 8px;" @click="readText">
        Read Text
    </input>
</div>
